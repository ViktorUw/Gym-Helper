# Copy to .env.docker and fill in the values. Used by docker-compose.yml.

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# The address you open in the browser, with scheme and port
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL: the db container creates this database and user on first start
POSTGRES_DB=gymhelper
POSTGRES_USER=gymhelper
POSTGRES_PASSWORD=
POSTGRES_HOST=db
